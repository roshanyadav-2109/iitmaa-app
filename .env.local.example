# IITMAA Sangam — local environment template. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://zrftldroguntsahfqugu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SPONSOR_LOGOS_BUCKET=logos
# Folder prefix inside the LOGOS bucket. Storage is not event-scoped the way
# the database is, so each edition reads from its own prefix.
SPONSOR_LOGOS_PREFIX=sangam
# Optional: set for private buckets to write signed URLs instead of public URLs.
SPONSOR_LOGOS_SIGNED_SECONDS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Sangam event row in public.events. NOT cosmetic: every scoped query
# filters on this and every insert sets it.
NEXT_PUBLIC_EVENT_ID=5a9a0000-0000-4000-8000-000000000003

# Create a new OAuth client for the Sangam domain — the PanIIT one is bound to
# app.vja.paniit.space and will not work here.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@iitmaa.org
